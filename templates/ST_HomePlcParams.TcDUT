<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.0">
  <DUT Name="ST_HomePlcParams" Id="{17b5395b-2936-4c65-a8bd-047c0d21ef11}">
    <Declaration><![CDATA[// Parameters of FB_HomePlc. Units are the axis's user units (mm, mm/s,
// mm/s^2 for an axis scaled in mm). Read when bExecute rises; FB_HomePlc
// refuses a run with the direction left undefined or a value <= 0.
TYPE ST_HomePlcParams :
STRUCT
    // towards the switch: MC_Positive_Direction or MC_Negative_Direction
    eSearchDirection   : MC_Direction := MC_Direction.MC_Undefined_Direction;
    fSearchVelocity    : LREAL;     // towards the switch, > 0
    fMoveOffVelocity   : LREAL;     // off the switch, if on it at start
    fDeceleration      : LREAL;     // every MC_Halt of the run, > 0
    fReferencePosition : LREAL;     // the position the switch edge gets
    bMarkNcHomed       : BOOL;      // TRUE: NC homed state; FALSE: own flag
    tStepTimeout       : TIME := T#30S;  // per step; size from travel
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
